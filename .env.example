# Copy this file to `.env` and paste your keys there. Never commit .env, never share keys in chat.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key (main model in this project): https://console.groq.com/keys
GROQ_API_KEY=

# --- AI Promo Intelligence Studio (all optional) ---
# Database file (default: data/studio.db, git-ignored)
# STUDIO_DB=data/studio.db
# Per-role model overrides (default: config.yaml `studio:` section, else llm.model)
# STUDIO_AGENT_MODEL=groq/openai/gpt-oss-120b
# STUDIO_STRANGER_MODEL=groq/openai/gpt-oss-20b
# STUDIO_CRITIC_MODEL=groq/openai/gpt-oss-120b
# STUDIO_STORY_MODEL=groq/openai/gpt-oss-120b
# STUDIO_COPILOT_MODEL=groq/openai/gpt-oss-20b

# --- n8n automation (disabled by default) ---
N8N_ENABLED=false
# Shared secret n8n must send in the X-Webhook-Secret header (use a long random string)
N8N_WEBHOOK_SECRET=
# Where the studio POSTs job.started / job.completed / job.failed events (ids and counts only)
N8N_CALLBACK_URL=
